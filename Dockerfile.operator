FROM golang:1.24-alpine AS builder
WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" -o /operator ./cmd/operator/...

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /operator /app/operator
USER 65532:65532
ENTRYPOINT ["/app/operator"]
