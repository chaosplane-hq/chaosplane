FROM golang:1.24-alpine AS builder
WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" -o /chaosctl ./cmd/chaosctl/...

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /chaosctl /app/chaosctl
USER 65532:65532
ENTRYPOINT ["/app/chaosctl"]
